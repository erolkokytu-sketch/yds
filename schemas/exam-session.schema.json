{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.yds-player.invalid/schemas/exam-session.v1.json",
  "title": "YDS Player Exam Session v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "examId",
    "examPackSchemaVersion",
    "state",
    "answers",
    "flaggedQuestionIds",
    "startedAt",
    "completedAt",
    "expiredAt",
    "timer",
    "result"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "examId": { "type": "string", "minLength": 1 },
    "examPackSchemaVersion": { "const": 1 },
    "state": { "enum": ["NOT_STARTED", "RUNNING", "PAUSED", "COMPLETED", "EXPIRED"] },
    "currentQuestionNumber": { "type": "integer", "minimum": 1 },
    "currentQuestionIndex": { "type": "integer", "minimum": 0 },
    "answers": {
      "type": "object",
      "additionalProperties": { "enum": ["A", "B", "C", "D", "E"] }
    },
    "flaggedQuestionIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "startedAt": { "$ref": "#/$defs/timestamp" },
    "completedAt": { "$ref": "#/$defs/timestamp" },
    "expiredAt": { "$ref": "#/$defs/timestamp" },
    "timer": {
      "oneOf": [
        { "$ref": "#/$defs/expectedEndTimer" },
        { "$ref": "#/$defs/legacyAccumulatedTimer" }
      ]
    },
    "result": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["correct", "wrong", "blank", "score"],
          "properties": {
            "correct": { "type": "integer", "minimum": 0 },
            "wrong": { "type": "integer", "minimum": 0 },
            "blank": { "type": "integer", "minimum": 0 },
            "score": { "type": ["number", "null"], "minimum": 0 }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "required": ["currentQuestionNumber"],
      "properties": { "currentQuestionNumber": { "type": "integer", "minimum": 1 } }
    },
    {
      "required": ["currentQuestionIndex"],
      "properties": { "currentQuestionIndex": { "type": "integer", "minimum": 0 } }
    }
  ],
  "$defs": {
    "timestamp": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "type": "integer", "minimum": 0 },
        { "type": "null" }
      ]
    },
    "expectedEndTimer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "durationMs", "expectedEndAt", "pausedAt", "remainingMsWhenPaused"],
      "properties": {
        "model": { "const": "expected-end-v1" },
        "durationMs": { "type": "integer", "minimum": 1 },
        "expectedEndAt": { "type": ["integer", "null"], "minimum": 0 },
        "pausedAt": { "type": ["integer", "null"], "minimum": 0 },
        "remainingMsWhenPaused": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "legacyAccumulatedTimer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationSeconds", "accumulatedElapsedSeconds", "runStartedAt", "pausedAt"],
      "properties": {
        "durationSeconds": { "type": "integer", "minimum": 1 },
        "accumulatedElapsedSeconds": { "type": "integer", "minimum": 0 },
        "runStartedAt": { "type": ["string", "null"], "format": "date-time" },
        "pausedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}
