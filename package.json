{
  "name": "yds-personal-exam-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "import:pdf": "node tools/run-pdf-import.mjs",
    "finalize:exam": "node scripts/finalize-exam.mjs",
    "verify:pdf-player": "node scripts/verify-pdf-pack-player.mjs",
    "validate:exam": "node scripts/validate-exam.mjs",
    "test": "npm run test:schema && npm run test:pdf && npm run test:ui && npm run test:pwa",
    "test:schema": "node --test test/exam-pack-validator.test.mjs",
    "test:pdf": "node tools/run-python-tests.mjs",
    "test:ui": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:production": "npm run build && PWA_E2E=1 playwright test --config=playwright.production.config.ts",
    "test:pwa": "vite build --base=/YDS/ && node --test test/pwa.test.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "node --check src/exam-pack-validator.mjs && node --check scripts/validate-exam.mjs && node --check scripts/finalize-exam.mjs && node --check scripts/verify-pdf-pack-player.mjs && node --check tools/run-pdf-import.mjs && node --check tools/run-python-tests.mjs && node --check test/exam-pack-validator.test.mjs && node --check test/pwa.test.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "idb": "^8.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.2"
  }
}
